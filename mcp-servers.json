[
  {
    "name": "local_fs",
    "transport": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "."
    ]
  },
  {
    "name": "github",
    "transport": "http",
